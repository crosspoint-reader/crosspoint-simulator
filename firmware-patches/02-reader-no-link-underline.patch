From cfdbf53fcfc3d36d29c877ce933b3866b58b0568 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 31 Jul 2026 17:04:21 +0000
Subject: [PATCH] reader: drop underline decoration on EPUB links

The reader has no way to select or follow a link inline, so the forced
underline on internal <a href> spans is pure visual noise. Stop tagging
anchor style entries with CssTextDecoration::Underline in
ChapterHtmlSlimParser::startElement. The style entry is still pushed so
direction inheritance and the depth-keyed pop in endElement stay
symmetric, and footnote link collection is untouched.

<u>/<ins> tags and CSS text-decoration: underline keep rendering
underlines through the normal style paths; the TextBlock decoration
drawing is shared with those sources and stays as is.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011Y2uNauEmkUi5Fs5Sa573x
---
 lib/Epub/Epub/parsers/ChapterHtmlSlimParser.cpp | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/lib/Epub/Epub/parsers/ChapterHtmlSlimParser.cpp b/lib/Epub/Epub/parsers/ChapterHtmlSlimParser.cpp
index 21b2654..f74e0f5 100644
--- a/lib/Epub/Epub/parsers/ChapterHtmlSlimParser.cpp
+++ b/lib/Epub/Epub/parsers/ChapterHtmlSlimParser.cpp
@@ -907,11 +907,13 @@ void XMLCALL ChapterHtmlSlimParser::startElement(void* userData, const XML_Char*
       self->currentFootnote.number[0] = '\0';
       self->currentFootnoteLinkTextLen = 0;
 
-      // Apply underline style to visually indicate the link.
+      // Links are deliberately not underlined: the reader has no way to select
+      // or follow a link inline, so the decoration is pure visual noise. The
+      // entry is still pushed so direction inheritance and the depth-keyed pop
+      // in endElement stay symmetric. <u>/<ins> tags and CSS text-decoration
+      // keep their underlines through the normal style paths.
       StyleStackEntry entry;
       entry.depth = self->depth;
-      entry.hasTextDecoration = true;
-      entry.textDecoration = CssTextDecoration::Underline;
       applyDirectionToEntry(entry, cssStyle);
       self->inlineStyleStack.push_back(entry);
       self->updateEffectiveInlineStyle();
