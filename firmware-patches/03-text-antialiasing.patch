diff --git a/src/activities/reader/ReaderUtils.h b/src/activities/reader/ReaderUtils.h
index 9ef55c2..b2d25fa 100644
--- a/src/activities/reader/ReaderUtils.h
+++ b/src/activities/reader/ReaderUtils.h
@@ -129,12 +129,26 @@ inline void displayWithRefreshCycle(const GfxRenderer& renderer, int& pagesUntil
