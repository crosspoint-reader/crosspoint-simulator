+class GfxRenderer;
+
+// Draws the calendar sleep screens ("Calendar Four/Five/Six" in Settings).
+//
+// One parameterized renderer backs all three styles: a grid of `weeks` rows
+// by 7 columns starting on the Sunday of the current week, today highlighted,
+// holidays (see HolidayCalculator) marked with a dot. Draws into the frame
+// buffer only — the caller owns the displayBuffer() call, like the other
+// SleepActivity render helpers own theirs.
+namespace CalendarSleepScreen {
+
+// Renders the calendar into the frame buffer. Returns false without touching
+// the buffer when no usable date exists (no RTC, or the RTC read failed) so
+// the caller can fall back to another sleep screen.
+bool render(GfxRenderer& renderer, uint8_t weeks);
+
+}  // namespace CalendarSleepScreen
