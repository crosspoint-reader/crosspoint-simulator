+void SleepActivity::renderCalendarSleepScreen(const uint8_t weeks) const {
+  // Without an RTC (X4) or with a failed RTC read there is no date to draw:
+  // fall back to the default sleep screen rather than showing a wrong month.
+  if (!CalendarSleepScreen::render(renderer, weeks)) {
+    return renderDefaultSleepScreen();
+  }
+  // Single HALF refresh for stock parity — see renderDefaultSleepScreen's note.
+  renderer.displayBuffer(HalDisplay::HALF_REFRESH);
+}
