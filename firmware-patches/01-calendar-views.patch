+bool HalClock::getDateTime(uint16_t& year, uint8_t& month, uint8_t& day, uint8_t& hour, uint8_t& minute) const {
+  if (!_available) return false;
+
+  Rtc::DateTime dt;
+  if (!_sdkRtc.now(dt)) return false;
+
+  year = dt.year;
+  month = dt.month;
+  day = dt.day;
+  hour = dt.hour;
+  minute = dt.minute;
+
+  // Refresh getTime()'s cache while we hold a fresh reading.
+  _cachedHour = dt.hour;
+  _cachedMinute = dt.minute;
+  _lastPollMs = millis();
+  _hasCachedTime = true;
+  return true;
+}
