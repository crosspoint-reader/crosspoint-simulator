new file mode 100644
index 00000000..556652d5
--- /dev/null
+++ b/src/activities/boot_sleep/HolidayCalculator.cpp
@@ -0,0 +1,35 @@
+#include "HolidayCalculator.h"
+
+namespace {
+
+// Anonymous Gregorian computus (Meeus/Jones/Butcher): Easter Sunday for a
+// given year, valid for all Gregorian years. Integer-only, no tables.
+void easterSunday(const uint16_t year, uint8_t& month, uint8_t& day) {
+  const int a = year % 19;
+  const int b = year / 100;
+  const int c = year % 100;
+  const int d = b / 4;
+  const int e = b % 4;
+  const int f = (b + 8) / 25;
+  const int g = (b - f + 1) / 3;
+  const int h = (19 * a + b - d - g + 15) % 30;
+  const int i = c / 4;
+  const int k = c % 4;
+  const int l = (32 + 2 * e + 2 * i - h - k) % 7;
+  const int m = (a + 11 * h + 22 * l) / 451;
+  month = static_cast<uint8_t>((h + l - 7 * m + 114) / 31);
+  day = static_cast<uint8_t>((h + l - 7 * m + 114) % 31 + 1);
+}
+
+}  // namespace
+
+bool HolidayCalculator::isHoliday(const uint16_t year, const uint8_t month, const uint8_t day) {
+  // Fixed-date holidays.
+  if (month == 1 && day == 1) return true;    // New Year's Day
+  if (month == 12 && day == 25) return true;  // Christmas Day
+
+  // Movable feast: Western Easter Sunday.
+  uint8_t easterMonth, easterDay;
+  easterSunday(year, easterMonth, easterDay);
+  return month == easterMonth && day == easterDay;
+}
