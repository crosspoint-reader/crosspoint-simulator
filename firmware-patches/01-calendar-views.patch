diff --git a/src/activities/boot_sleep/CalendarSleepScreen.cpp b/src/activities/boot_sleep/CalendarSleepScreen.cpp
new file mode 100644
index 00000000..c97288a8
--- /dev/null
+++ b/src/activities/boot_sleep/CalendarSleepScreen.cpp
@@ -0,0 +1,203 @@
+#include "CalendarSleepScreen.h"
+
+#include <GfxRenderer.h>
+#include <HalClock.h>
+#include <I18n.h>
+
+#include <cstdio>
+
+#include "CrossPointSettings.h"
+#include "HolidayCalculator.h"
+#include "fontIds.h"
+
+namespace {
+
+// --- Civil-date arithmetic (Howard Hinnant's public-domain algorithms) ----
+// Integer-only and valid across all Gregorian dates, so week rows that cross
+// month and year boundaries need no special cases.
+
+struct CivilDate {
+  int year;
+  unsigned month;  // 1-12
+  unsigned day;    // 1-31
+};
+
+// Days since 1970-01-01 for a civil date.
+constexpr int32_t daysFromCivil(int y, const unsigned m, const unsigned d) {
+  y -= m <= 2;
+  const int32_t era = (y >= 0 ? y : y - 399) / 400;
+  const uint32_t yoe = static_cast<uint32_t>(y - era * 400);
+  const uint32_t doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+  const uint32_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  return era * 146097 + static_cast<int32_t>(doe) - 719468;
+}
+
+// Civil date for days since 1970-01-01.
+constexpr CivilDate civilFromDays(int32_t z) {
+  z += 719468;
+  const int32_t era = (z >= 0 ? z : z - 146096) / 146097;
+  const uint32_t doe = static_cast<uint32_t>(z - era * 146097);
+  const uint32_t yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+  const int y = static_cast<int>(yoe) + era * 400;
+  const uint32_t doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+  const uint32_t mp = (5 * doy + 2) / 153;
+  const uint32_t d = doy - (153 * mp + 2) / 5 + 1;
+  const uint32_t m = mp + (mp < 10 ? 3 : static_cast<uint32_t>(-9));
+  return {y + (m <= 2), m, d};
+}
+
+// Weekday for days since 1970-01-01; 0=Sunday (matches Rtc::DateTime::weekday).
+constexpr unsigned weekdayFromDays(const int32_t z) {
+  return static_cast<unsigned>(z >= -4 ? (z + 4) % 7 : (z + 5) % 7 + 6);
+}
+
+// Resolve today's local date as days-since-epoch. The RTC runs on UTC (see
+// HalClock::syncFromNTP), so apply the user's clock offset the same way the
+// status-bar clock does before deciding which day "today" is.
+bool resolveLocalToday(int32_t& outDays) {
+  uint16_t year;
+  uint8_t month, day, hour, minute;
+  if (!halClock.getDateTime(year, month, day, hour, minute)) return false;
+
+  uint8_t offsetQ = SETTINGS.clockUtcOffsetQ;
+  if (offsetQ > 104) offsetQ = 104;  // clamp corrupted persisted values, matching HalClock::formatTime
+  const int offsetMinutes = (static_cast<int>(offsetQ) - 48) * 15;
+
+  int32_t days = daysFromCivil(year, month, day);
+  const int localMinutes = static_cast<int>(hour) * 60 + static_cast<int>(minute) + offsetMinutes;
+  if (localMinutes < 0) {
+    days -= 1;
+  } else if (localMinutes >= 24 * 60) {
+    days += 1;
+  }
+  outDays = days;
+  return true;
+}
+
+constexpr StrId kDowIds[7] = {StrId::STR_CAL_DOW_SUN, StrId::STR_CAL_DOW_MON, StrId::STR_CAL_DOW_TUE,
+                              StrId::STR_CAL_DOW_WED, StrId::STR_CAL_DOW_THU, StrId::STR_CAL_DOW_FRI,
+                              StrId::STR_CAL_DOW_SAT};
+
+constexpr StrId kMonthIds[12] = {StrId::STR_CAL_MONTH_JANUARY,   StrId::STR_CAL_MONTH_FEBRUARY,
+                                 StrId::STR_CAL_MONTH_MARCH,     StrId::STR_CAL_MONTH_APRIL,
+                                 StrId::STR_CAL_MONTH_MAY,       StrId::STR_CAL_MONTH_JUNE,
+                                 StrId::STR_CAL_MONTH_JULY,      StrId::STR_CAL_MONTH_AUGUST,
+                                 StrId::STR_CAL_MONTH_SEPTEMBER, StrId::STR_CAL_MONTH_OCTOBER,
+                                 StrId::STR_CAL_MONTH_NOVEMBER,  StrId::STR_CAL_MONTH_DECEMBER};
+
+// Title for the rendered span: "July 2026", "July - August 2026", or
+// "December 2026 - January 2027" when the rows cross a boundary.
+void formatTitle(char* buf, const size_t bufSize, const CivilDate& first, const CivilDate& last) {
+  const char* firstMonth = I18N.get(kMonthIds[first.month - 1]);
+  const char* lastMonth = I18N.get(kMonthIds[last.month - 1]);
+  if (first.year != last.year) {
+    snprintf(buf, bufSize, "%s %d - %s %d", firstMonth, first.year, lastMonth, last.year);
+  } else if (first.month != last.month) {
+    snprintf(buf, bufSize, "%s - %s %d", firstMonth, lastMonth, first.year);
+  } else {
+    snprintf(buf, bufSize, "%s %d", firstMonth, first.year);
+  }
+}
+
+}  // namespace
+
+bool CalendarSleepScreen::render(GfxRenderer& renderer, uint8_t weeks) {
+  if (weeks < 1) weeks = 1;
+  if (weeks > 8) weeks = 8;
+
+  int32_t today;
+  if (!resolveLocalToday(today)) return false;
+
+  const int screenW = renderer.getScreenWidth();
+  const int screenH = renderer.getScreenHeight();
+  const int rows = weeks;
+  constexpr int kCols = 7;
+
+  // First cell: Sunday of the current week; today always sits in the top row.
+  const int32_t firstDay = today - static_cast<int32_t>(weekdayFromDays(today));
+
+  // --- Layout ------------------------------------------------------------
+  const int marginX = screenW / 20;
+  const int cellW = (screenW - 2 * marginX) / kCols;
+  const int gridW = cellW * kCols;
+  const int gridX = (screenW - gridW) / 2;
+
+  const int titleH = renderer.getLineHeight(UI_12_FONT_ID);
+  const int headerH = renderer.getLineHeight(SMALL_FONT_ID);
+  const int footerH = renderer.getLineHeight(SMALL_FONT_ID);
+  constexpr int kTitleGap = 18;
+  constexpr int kHeaderGap = 8;
+  constexpr int kFooterGap = 26;
+
+  int cellH = 64;
+  const int fixedH = titleH + kTitleGap + headerH + kHeaderGap + kFooterGap + footerH;
+  const int maxGridH = screenH - fixedH - 40;  // keep >=20px breathing room top and bottom
+  if (rows * cellH > maxGridH) cellH = maxGridH / rows;
+
+  const int blockH = fixedH + rows * cellH;
+  const int blockY = (screenH - blockH) / 2;
+
+  const int headerY = blockY + titleH + kTitleGap;
+  const int gridY = headerY + headerH + kHeaderGap;
+  const int footerY = gridY + rows * cellH + kFooterGap;
+
+  // --- Chrome ------------------------------------------------------------
+  renderer.clearScreen();
+
+  char title[64];
+  formatTitle(title, sizeof(title), civilFromDays(firstDay), civilFromDays(firstDay + rows * kCols - 1));
+  renderer.drawCenteredText(UI_12_FONT_ID, blockY, title, true, EpdFontFamily::BOLD);
+
+  for (int col = 0; col < kCols; col++) {
+    const char* label = I18N.get(kDowIds[col]);
+    const int labelX = gridX + col * cellW + (cellW - renderer.getTextWidth(SMALL_FONT_ID, label)) / 2;
+    renderer.drawText(SMALL_FONT_ID, labelX, headerY, label);
+  }
+
+  // Grid lines.
+  for (int row = 0; row <= rows; row++) {
+    renderer.drawLine(gridX, gridY + row * cellH, gridX + gridW, gridY + row * cellH);
+  }
+  for (int col = 0; col <= kCols; col++) {
+    renderer.drawLine(gridX + col * cellW, gridY, gridX + col * cellW, gridY + rows * cellH);
+  }
+
+  // --- Day cells ---------------------------------------------------------
+  const int dayLineH = renderer.getLineHeight(UI_10_FONT_ID);
+  for (int row = 0; row < rows; row++) {
+    for (int col = 0; col < kCols; col++) {
+      const int32_t dayIndex = firstDay + row * kCols + col;
+      const CivilDate date = civilFromDays(dayIndex);
+      const bool isToday = dayIndex == today;
+      const bool isHoliday = HolidayCalculator::isHoliday(static_cast<uint16_t>(date.year),
+                                                          static_cast<uint8_t>(date.month),
+                                                          static_cast<uint8_t>(date.day));
+
+      const int cellX = gridX + col * cellW;
+      const int cellY = gridY + row * cellH;
+
+      if (isToday) {
+        // Inset so the highlight does not swallow the 1px grid lines.
+        renderer.fillRoundedRect(cellX + 3, cellY + 3, cellW - 5, cellH - 5, 8, Black);
+      }
+
+      char dayText[4];
+      snprintf(dayText, sizeof(dayText), "%u", date.day);
+      const int textX = cellX + (cellW - renderer.getTextWidth(UI_10_FONT_ID, dayText)) / 2;
+      const int textY = cellY + (cellH - dayLineH) / 2;
+      renderer.drawText(UI_10_FONT_ID, textX, textY, dayText, !isToday);
+
+      if (isHoliday) {
+        constexpr int kDotSize = 6;
+        const int dotY = cellY + cellH - kDotSize - 5;
+        if (dotY > textY + dayLineH - 4) {  // only when the cell is tall enough to fit it under the number
+          renderer.fillRoundedRect(cellX + (cellW - kDotSize) / 2, dotY, kDotSize, kDotSize, kDotSize / 2,
+                                   isToday ? White : Black);
+        }
+      }
+    }
+  }
+
+  renderer.drawCenteredText(SMALL_FONT_ID, footerY, tr(STR_SLEEPING));
+  return true;
+}
