<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>CrossPoint X3</string>
  <key>CFBundleDisplayName</key>
  <string>CrossPoint X3</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <!-- Both are set from CMake so the deploy script can bump them without
       editing this file. CFBundleVersion must be unique per marketing version,
       and TestFlight's daily upload cap (error 90382) is ALSO per marketing
       version -- so hitting it means bumping CFBundleShortVersionString, not
       waiting a day. -->
  <key>CFBundleShortVersionString</key>
  <string>@CROSSPOINT_IOS_MARKETING_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@CROSSPOINT_IOS_BUILD_NUMBER@</string>
  <key>LSRequiresIPhoneOS</key>
  <true/>

  <!-- No encryption beyond what the OS provides. Declaring it here means
       TestFlight uploads skip the export-compliance prompt every time. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>

  <!-- Portrait only. The X3 panel is presented portrait and the control zones
       are laid out beneath it; rotation would invalidate the integer-scale
       geometry the 1-bit panel depends on. -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>

  <!-- File sharing, so EPUB/TXT can be sideloaded via Files. The real X3 has no
       USB port (pogo pins), so this is the only practical way to get books in. -->
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>

  <key>UILaunchScreen</key>
  <dict>
    <key>UIColorName</key>
    <string></string>
  </dict>
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
  </array>
  <key>UIStatusBarHidden</key>
  <true/>
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <false/>
</dict>
</plist>
